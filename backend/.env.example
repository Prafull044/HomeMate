# HomeMate Environment Configuration
PORT=5000

# When hosting on Railway, MYSQL_URL or DATABASE_URL is automatically provided:
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway

# Or individual parameters (used locally or if MYSQL_URL is not set):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=homemate2
# DB_SSL=false
